# Sensitive files
*.key
*.pem
*.env
!*.env.example
.env
*.secret
*.yaml
!*.yaml.example
!*.yml.example

# Backup files
*.backup*
*.bak
*~

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo


# Sensitive configuration files (restore from backups, not Git)
configs/.env
configs/*-config.env
configs/secrets.env
configs/caddy/Caddyfile
configs/caddy/root-ca.crt
configs/caddy/data/
configs/caddy/config/
configs/pihole/*.conf
configs/pihole/*.list
configs/samba/smb.conf
configs/pihole/etc-pihole/
configs/pihole/etc-dnsmasq.d/
configs/netdata/

# Docker Compose deployed files (contain real values from env; only .yml.example is Git-tracked)
configs/docker-compose/*.yml
!configs/docker-compose/*.yml.example

# Docker daemon config (live copies generated from env; only .example is Git-tracked)
# Live files deploy to /etc/docker/ and /etc/systemd/system/docker.service.d/ (outside repo)
configs/docker/daemon.json
configs/docker/*.conf
!configs/docker/*.example

# Service persistent data (managed by Docker, not Git)
configs/docker-compose/*/data/
configs/docker-compose/*/config/
``

# Phase 6: Helper-managed service configs (live config with PII, generated compose files)
configs/helper-services/services.yml
configs/helper-services/*/
configs/helper-services/*.bak
configs/helper-services/*.bak.*
!configs/helper-services/.gitkeep
!configs/helper-services/services.yml.example
